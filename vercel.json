{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "base-44-downtown-perks-live.vercel.app"
  ],
  "buildCommand": "node scripts/test-platform-integration-gate.mjs && node scripts/test-platform-interaction-completeness.mjs && npm run build",
  "redirects": [
    {
      "source": "/resident-app",
      "destination": "/map?mode=resident&tab=map&filter=Featured&collection=downtown-perks-featured",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/app-logs/(.*)",
      "destination": "/api/app-log"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/events",
      "destination": "/index.html"
    },
    {
      "source": "/perks",
      "destination": "/index.html"
    },
    {
      "source": "/properties",
      "destination": "/index.html"
    },
    {
      "source": "/hotels",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
