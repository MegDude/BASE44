{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/aggregate",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/pricing",
      "schedule": "10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
