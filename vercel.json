{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "base-44-downtown-perks-live.vercel.app"
  ],
  "rewrites": [
    {
      "source": "/api/app-logs/(.*)",
      "destination": "/api/app-log"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/events",
      "destination": "/index.html"
    },
    {
      "source": "/perks",
      "destination": "/index.html"
    },
    {
      "source": "/properties",
      "destination": "/index.html"
    },
    {
      "source": "/hotels",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
