# Core app URL
# Recommended on Vercel: your production domain, for example https://downtown-perks.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# Required for sign-in, sign-up, /admin, and all database-backed persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist for /admin access.
ADMIN_EMAILS=hello@downtownperks.com

# Stripe
# Required for live checkout sessions and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe Price IDs. If omitted, /api/checkout will create inline price_data.
STRIPE_PRICE_VENUE_PILOT=
STRIPE_PRICE_PROPERTY_PILOT=

# Twilio
# Required for live SMS sending and signed status callbacks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio Verify Service SID — required for phone OTP auth (/api/auth/request-otp + /api/auth/verify-otp)
# Create a Verify Service at: https://console.twilio.com/us1/develop/verify/services
TWILIO_VERIFY_SERVICE_SID=

# JWT secret for the QR/OTP/Redemption flow — generate with: openssl rand -base64 32
PERK_JWT_SECRET=

# Optional override for Twilio status callbacks.
# If empty, the app uses ${NEXT_PUBLIC_SITE_URL}/api/twilio/status or the request origin.
TWILIO_STATUS_CALLBACK_URL=
